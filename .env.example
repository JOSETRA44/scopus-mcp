# Copy to .env and fill in. Never commit the filled-in file.


# Elsevier API key, free from https://dev.elsevier.com/. Required.
# Required: yes  |  Secret: keep it out of version control
SCOPUS_API_KEY=

# Institutional token. Required only for author profiles and citation overviews, and only works from a subscribing institution's network.
# Required: no  |  Secret: keep it out of version control
SCOPUS_INST_TOKEN=
