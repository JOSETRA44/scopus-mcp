# Prefer `scopus setup` for guided configuration, or copy this to .env.
# Never commit the filled-in file.


# Elsevier API key from https://dev.elsevier.com/. Endpoint access depends on entitlements.
# Required: yes  |  Secret: keep it out of version control
SCOPUS_API_KEY=

# Optional institutional token. Ask your institution/Elsevier about endpoint permissions and network requirements.
# Required: no  |  Secret: keep it out of version control
SCOPUS_INST_TOKEN=

# Maximum cumulative quota/retry wait per request (seconds, 0-60).
SCOPUS_MAX_WAIT_SECONDS=10
